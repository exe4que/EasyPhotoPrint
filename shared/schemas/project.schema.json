{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easyphotoprint.app/schemas/project.v1.json",
  "title": "EPPProject",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "pages", "imagePool"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1 },
    "pages": {
      "type": "array",
      "items": { "$ref": "#/$defs/Page" }
    },
    "imagePool": {
      "type": "array",
      "items": { "$ref": "#/$defs/ImageAsset" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "PageConfig": {
      "type": "object",
      "required": ["sizePreset", "orientation", "dpi"],
      "properties": {
        "sizePreset": {
          "enum": ["A4", "Letter", "Legal", "4x6", "5x7", "A3", "Custom"]
        },
        "customSizeMm": {
          "type": "object",
          "required": ["widthMm", "heightMm"],
          "properties": {
            "widthMm": { "type": "number", "exclusiveMinimum": 0 },
            "heightMm": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        },
        "orientation": { "enum": ["portrait", "landscape"] },
        "dpi": { "type": "integer", "minimum": 72, "default": 300 }
      },
      "additionalProperties": false
    },
    "LayoutNode": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "enum": ["grid", "horizontal", "vertical", "imageSlot", "freeformCanvas"]
        },
        "sizeRatio": { "type": "number", "default": 1 },
        "fixedSizeMm": {
          "type": "object",
          "properties": {
            "widthMm": { "type": "number", "exclusiveMinimum": 0 },
            "heightMm": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        },
        "alignment": {
          "type": "object",
          "properties": {
            "horizontal": { "enum": ["left", "center", "right", "expand"] },
            "vertical": { "enum": ["top", "center", "bottom", "expand"] }
          },
          "additionalProperties": false
        },
        "gapMm": { "type": "number", "minimum": 0, "default": 0 },
        "paddingMm": {
          "type": "object",
          "properties": {
            "top": { "type": "number" },
            "right": { "type": "number" },
            "bottom": { "type": "number" },
            "left": { "type": "number" }
          },
          "additionalProperties": false
        },
        "gridConfig": {
          "type": "object",
          "properties": {
            "rows": { "type": "integer", "minimum": 1 },
            "columns": { "type": "integer", "minimum": 1 },
            "autoFit": { "type": "boolean", "default": false },
            "rowGapMm": { "type": "number", "minimum": 0 },
            "columnGapMm": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "imageSlotConfig": {
          "type": "object",
          "properties": {
            "aspectRatio": { "type": "number" },
            "scalingRule": {
              "enum": ["fitInParent", "envelopeParent", "stretch"],
              "default": "fitInParent"
            },
            "focalPoint": {
              "type": "object",
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "freeformElements": {
          "type": "array",
          "items": { "$ref": "#/$defs/FreeformElement" }
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/LayoutNode" }
        }
      },
      "additionalProperties": false
    },
    "FreeformElement": {
      "type": "object",
      "required": ["id", "imageNodeId", "transform"],
      "properties": {
        "id": { "type": "string" },
        "imageNodeId": { "type": "string" },
        "zIndex": { "type": "integer", "default": 0 },
        "transform": {
          "type": "object",
          "required": ["xMm", "yMm", "widthMm", "heightMm", "rotationDeg"],
          "properties": {
            "xMm": { "type": "number" },
            "yMm": { "type": "number" },
            "widthMm": { "type": "number", "exclusiveMinimum": 0 },
            "heightMm": { "type": "number", "exclusiveMinimum": 0 },
            "rotationDeg": { "type": "number", "minimum": -180, "maximum": 180 },
            "lockAspectRatio": { "type": "boolean", "default": true }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "Page": {
      "type": "object",
      "required": ["id", "pageConfig", "rootNode", "assignments"],
      "properties": {
        "id": { "type": "string" },
        "pageConfig": { "$ref": "#/$defs/PageConfig" },
        "templateRef": { "type": "string" },
        "rootNode": { "$ref": "#/$defs/LayoutNode" },
        "assignments": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "ImageAsset": {
      "type": "object",
      "required": [
        "id",
        "originalPath",
        "storedPath",
        "fileName",
        "widthPx",
        "heightPx",
        "thumbnailDataUrl"
      ],
      "properties": {
        "id": { "type": "string" },
        "originalPath": { "type": "string", "minLength": 1 },
        "storedPath": { "type": "string", "minLength": 1 },
        "fileName": { "type": "string", "minLength": 1 },
        "widthPx": { "type": "integer", "minimum": 1 },
        "heightPx": { "type": "integer", "minimum": 1 },
        "dpiOriginal": { "type": "number", "exclusiveMinimum": 0 },
        "thumbnailDataUrl": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
